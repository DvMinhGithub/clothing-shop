<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.demo.mapper.BrandMapper">

    <resultMap id="BrandDtoResultMap" type="com.example.demo.model.dto.BrandDto" autoMapping="true">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
    </resultMap>

    <select id="existsByName" resultType="java.lang.Boolean">
        SELECT EXISTS(SELECT 1 FROM brand b WHERE b.name = #{brandName})
    </select>

    <insert id="create">
        INSERT INTO brand(name, description)
        VALUES (#{brandInfo.name},
                #{brandInfo.description})
    </insert>

    <select id="findAll" resultMap="BrandDtoResultMap">
        SELECT b.id          as id,
               b.name        as name,
               b.description as description
        FROM brand b
    </select>

    <select id="findById" resultMap="BrandDtoResultMap">
        SELECT b.id          as id,
               b.name        as name,
               b.description as description
        FROM brand b
        WHERE b.id = #{brandId}
    </select>

    <update id="update">
        UPDATE brand
        SET name        = #{brandInfo.name},
            description = #{brandInfo.description}
        WHERE id = #{brandId}
    </update>
</mapper>