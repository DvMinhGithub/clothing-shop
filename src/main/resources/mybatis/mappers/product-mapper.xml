<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.demo.mapper.ProductMapper">

    <resultMap id="ProductDtoResultMap" type="com.example.demo.model.dto.ProductDto" autoMapping="true">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="view" property="view"/>
        <result column="sold" property="sold"/>
        <result column="productImage" property="productImage"/>
        <result column="isDeleted" property="isDeleted"/>
        <result column="price" property="price"/>
    </resultMap>

    <insert id="create" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product(name,
                            description,
                            price,
                            product_image,
                            brand_id)
        VALUES (#{productInfo.name},
                #{productInfo.description},
                #{productInfo.price},
                #{productInfo.productImage},
                #{productInfo.brandId})
    </insert>

    <insert id="setCategory">
        INSERT INTO product_category(product_id,
                                     category_id)
        VALUES (#{productId},
                #{categoryId})
    </insert>


</mapper>