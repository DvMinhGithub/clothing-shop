<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.demo.mapper.CategoryMapper">

    <resultMap id="CategoryDtoResultMap" type="com.example.demo.model.dto.CategoryDto" autoMapping="true">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
    </resultMap>

    <select id="existsByName" resultType="java.lang.Boolean">
        SELECT EXISTS(SELECT 1 FROM category c WHERE c.name = #{categoryName})
    </select>

    <insert id="create">
        INSERT INTO category(name, description)
        VALUES (#{categoryInfo.name},
        #{categoryInfo.description})
    </insert>

    <select id="findAll" resultMap="CategoryDtoResultMap">
        SELECT c.id as id,
        c.name as name,
        c.description as description
        FROM category c
        ORDER BY c.id desc
    </select>

    <select id="findById" resultMap="CategoryDtoResultMap">
        SELECT c.id as id,
        c.name as name,
        c.description as description
        FROM category c
        WHERE c.id = #{categoryId}
    </select>

    <update id="update">
        UPDATE category
        SET name = #{categoryInfo.name},
        description = #{categoryInfo.description}
        WHERE id = #{categoryId}
    </update>
</mapper>