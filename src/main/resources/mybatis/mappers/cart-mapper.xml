<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.demo.mapper.CartMapper">

    <resultMap id="CartItemDtoResultMap" type="com.example.demo.model.dto.CartItemDto" autoMapping="true">
        <id column="id" property="id"/>
        <result column="quantity" property="quantity"/>
        <result column="productId" property="productId"/>
        <result column="productImage" property="productImage"/>
        <result column="productName" property="productName"/>
        <result column="productPrice" property="productPrice"/>
    </resultMap>

    <select id="getByUserId" resultMap="CartItemDtoResultMap">
        SELECT ci.id           as id,
               ci.quantity     as quantity,
               p.product_image as productImage,
               p.name          as productName,
               p.price         as productPrice,
               p.id            as productId
        FROM cart_item ci
                 INNER JOIN product p ON p.id = ci.product_id
        WHERE ci.user_id = #{userId}
    </select>

    <insert id="addToCart">
        INSERT INTO cart_item(quantity, product_id, user_id)
        VALUES (#{addToCartInfo.quantity}, #{addToCartInfo.idProduct}, #{userId})
    </insert>

    <update id="updateCartItemQuantity">
        UPDATE cart_item
        SET quantity = #{quantity}
        WHERE id = #{cartItemId}
    </update>

    <delete id="deleteCartItem">
        DELETE FROM cart_item
        WHERE id = #{cartItemId}
    </delete>
</mapper>